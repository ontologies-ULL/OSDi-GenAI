    <!-- Enfermedad: Deficiencia de Biotinidasa -->
<Declaration>
<NamedIndividual IRI="#BTD_Disease"/>
</Declaration>
<ClassAssertion>
<Class IRI="#Disease"/>
<NamedIndividual IRI="#BTD_Disease"/>
</ClassAssertion>
<DataPropertyAssertion>
<DataProperty IRI="#hasDescription"/>
<NamedIndividual IRI="#BTD_Disease"/>
<Literal>Biotinidase deficiency is an autosomal recessive metabolic disorder affecting biotin recycling</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
<DataProperty IRI="#hasSource"/>
<NamedIndividual IRI="#BTD_Disease"/>
<Literal>Global incidence of approximately 1 in 60,000 births</Literal>
</DataPropertyAssertion>

<!-- Estadios de la enfermedad -->
<Declaration>
<NamedIndividual IRI="#BTD_Stage_Profound"/>
</Declaration>
<ClassAssertion>
<Class IRI="#DiseaseStage"/>
<NamedIndividual IRI="#BTD_Stage_Profound"/>
</ClassAssertion>
<DataPropertyAssertion>
<DataProperty IRI="#hasDescription"/>
<NamedIndividual IRI="#BTD_Stage_Profound"/>
<Literal>Profound biotinidase deficiency, with enzyme activity ≤10% of normal</Literal>
</DataPropertyAssertion>

<Declaration>
<NamedIndividual IRI="#BTD_Stage_Partial"/>
</Declaration>
<ClassAssertion>
<Class IRI="#DiseaseStage"/>
<NamedIndividual IRI="#BTD_Stage_Partial"/>
</ClassAssertion>
<DataPropertyAssertion>
<DataProperty IRI="#hasDescription"/>
<NamedIndividual IRI="#BTD_Stage_Partial"/>
<Literal>Partial biotinidase deficiency, with enzyme activity between 10.1% and 30% of normal</Literal>
</DataPropertyAssertion>

