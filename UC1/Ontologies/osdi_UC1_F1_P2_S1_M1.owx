    <!-- Enfermedad y clasificación -->
<Declaration>
    <NamedIndividual IRI="#BD_Enfermedad"/>
</Declaration>
<ClassAssertion>
    <Class IRI="#Enfermedad"/>
    <NamedIndividual IRI="#BD_Enfermedad"/>
</ClassAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasDescription"/>
    <NamedIndividual IRI="#BD_Enfermedad"/>
    <Literal>Deficiencia profunda de biotinidasa (OMIM 253260), trastorno autosómico recesivo del metabolismo de la biotina</Literal>
</DataPropertyAssertion>

<!-- Manifestaciones clínicas -->
<Declaration>
    <NamedIndividual IRI="#BD_Manif_Convulsiones"/>
</Declaration>
<ClassAssertion>
    <Class IRI="#ManifestacionClinica"/>
    <NamedIndividual IRI="#BD_Manif_Convulsiones"/>
</ClassAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasDescription"/>
    <NamedIndividual IRI="#BD_Manif_Convulsiones"/>
    <Literal>Convulsiones mioclónicas o tónico-clónicas, frecuentes en pacientes no tratados</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasSource"/>
    <NamedIndividual IRI="#BD_Manif_Convulsiones"/>
    <Literal>Couce et al. 2011[1]; Weber et al. 2004[2]</Literal>
</DataPropertyAssertion>

<!-- Otras manifestaciones (estructura similar) -->
<Declaration>
    <NamedIndividual IRI="#BD_Manif_Hipoacusia"/>
</Declaration>
<DataPropertyAssertion>
    <DataProperty IRI="#hasDescription"/>
    <NamedIndividual IRI="#BD_Manif_Hipoacusia"/>
    <Literal>Hipoacusia neurosensorial bilateral, prevalente en 55% de casos sintomáticos</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasSource"/>
    <NamedIndividual IRI="#BD_Manif_Hipoacusia"/>
    <Literal>Genc et al. 2007[5]; Wolf et al. 2002[6]</Literal>
</DataPropertyAssertion>

<!-- Estadios de la enfermedad -->
<Declaration>
    <NamedIndividual IRI="#BD_Estadio_NoTratado"/>
</Declaration>
<ClassAssertion>
    <Class IRI="#EstadioEnfermedad"/>
    <NamedIndividual IRI="#BD_Estadio_NoTratado"/>
</ClassAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasDescription"/>
    <NamedIndividual IRI="#BD_Estadio_NoTratado"/>
    <Literal>Fase sintomática con afectación neurológica y metabólica activa</Literal>
</DataPropertyAssertion>

<!-- Parámetros epidemiológicos -->
<Declaration>
    <NamedIndividual IRI="#BD_Epid_Incidencia"/>
</Declaration>
<ClassAssertion>
    <Class IRI="#EpidemiologicalParameter"/>
    <NamedIndividual IRI="#BD_Epid_Incidencia"/>
</ClassAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasExpectedValue"/>
    <NamedIndividual IRI="#BD_Epid_Incidencia"/>
    <Literal>1:60000</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasSource"/>
    <NamedIndividual IRI="#BD_Epid_Incidencia"/>
    <Literal>Wolf 1995[4]; Baykal et al. 1998[3]</Literal>
</DataPropertyAssertion>

<!-- Parámetros de utilidad -->
<Declaration>
    <NamedIndividual IRI="#BD_Manif_Convulsiones_U"/>
</Declaration>
<ClassAssertion>
    <Class IRI="#UtilityParameter"/>
    <NamedIndividual IRI="#BD_Manif_Convulsiones_U"/>
</ClassAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasExpectedValue"/>
    <NamedIndividual IRI="#BD_Manif_Convulsiones_U"/>
    <Literal>0.65</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasSource"/>
    <NamedIndividual IRI="#BD_Manif_Convulsiones_U"/>
    <Literal>Grünewald et al. 2003[3]; Salbert et al. 1993[4]</Literal>
</DataPropertyAssertion>

<!-- Intervenciones -->
<Declaration>
    <NamedIndividual IRI="#BD_Intervencion_Cribado"/>
</Declaration>
<ClassAssertion>
    <Class IRI="#Intervencion"/>
    <NamedIndividual IRI="#BD_Intervencion_Cribado"/>
</ClassAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasDescription"/>
    <NamedIndividual IRI="#BD_Intervencion_Cribado"/>
    <Literal>Cribado neonatal mediante ensayo enzimático fluorimétrico en papel</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasEffect"/>
    <NamedIndividual IRI="#BD_Intervencion_Cribado"/>
    <Literal>Reducción del 95% en manifestaciones neurológicas cuando se trata antes de los 3 meses</Literal>
</DataPropertyAssertion>

<!-- Relaciones clave -->
<ObjectPropertyAssertion>
    <ObjectProperty IRI="#hasManifestation"/>
    <NamedIndividual IRI="#BD_Enfermedad"/>
    <NamedIndividual IRI="#BD_Manif_Convulsiones"/>
</ObjectPropertyAssertion>

<ObjectPropertyAssertion>
    <ObjectProperty IRI="#affectsDiseaseStage"/>
    <NamedIndividual IRI="#BD_Intervencion_Cribado"/>
    <NamedIndividual IRI="#BD_Estadio_NoTratado"/>
</ObjectPropertyAssertion>

