<!-- DESCRIPCIÓN Y FUENTES DE CADA MANIFESTACIÓN CRÓNICA -->
<DataPropertyAssertion>
    <DataProperty IRI="#hasDescription"/>
    <NamedIndividual IRI="#DBP_Manif_DevelopmentalDelay"/>
    <Literal>Retraso global del desarrollo psicomotor y cognitivo, persistente tras episodios agudos y frecuente en diagnóstico tardío.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasSource"/>
    <NamedIndividual IRI="#DBP_Manif_DevelopmentalDelay"/>
    <Literal>2011-Clinical_and_genetic_findings_in_patients_with_biotinidase_deficiency_detected_through_newb.pdf</Literal>
</DataPropertyAssertion>

<DataPropertyAssertion>
    <DataProperty IRI="#hasDescription"/>
    <NamedIndividual IRI="#DBP_Manif_IntellectualDisability"/>
    <Literal>Discapacidad intelectual de grado variable, que puede ser consecuencia de daño neurológico irreversible.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasSource"/>
    <NamedIndividual IRI="#DBP_Manif_IntellectualDisability"/>
    <Literal>2009-Diagnosis_treatment_follow-up_and_gene_mutation_analysis_in_four_Chinese_children_with_biot.pdf</Literal>
</DataPropertyAssertion>

<DataPropertyAssertion>
    <DataProperty IRI="#hasDescription"/>
    <NamedIndividual IRI="#DBP_Manif_SensorineuralHearingLoss"/>
    <Literal>Pérdida auditiva neurosensorial, generalmente irreversible incluso tras tratamiento, de grado variable de moderada a profunda.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasSource"/>
    <NamedIndividual IRI="#DBP_Manif_SensorineuralHearingLoss"/>
    <Literal>2007-Audiologic_findings_in_children_with_biotinidase_deficiency_in_Turkey.pdf</Literal>
</DataPropertyAssertion>

<DataPropertyAssertion>
    <DataProperty IRI="#hasDescription"/>
    <NamedIndividual IRI="#DBP_Manif_OpticAtrophy"/>
    <Literal>Atrofia óptica, con pérdida visual permanente y progresiva, que no suele revertir con tratamiento.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasSource"/>
    <NamedIndividual IRI="#DBP_Manif_OpticAtrophy"/>
    <Literal>1993-Ophthalmologic_Findings_in_Biotinidase_Deficiency.pdf</Literal>
</DataPropertyAssertion>

<DataPropertyAssertion>
    <DataProperty IRI="#hasDescription"/>
    <NamedIndividual IRI="#DBP_Manif_VisualImpairment"/>
    <Literal>Deterioro visual persistente, incluyendo ceguera, fotofobia y alteraciones del campo visual.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasSource"/>
    <NamedIndividual IRI="#DBP_Manif_VisualImpairment"/>
    <Literal>1993-Ophthalmologic_Findings_in_Biotinidase_Deficiency.pdf</Literal>
</DataPropertyAssertion>

<DataPropertyAssertion>
    <DataProperty IRI="#hasDescription"/>
    <NamedIndividual IRI="#DBP_Manif_SpasticTetraplegia"/>
    <Literal>Tetraplejía espástica secundaria a daño cerebral crónico, descrita en casos de diagnóstico y tratamiento tardíos.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasSource"/>
    <NamedIndividual IRI="#DBP_Manif_SpasticTetraplegia"/>
    <Literal>Biotinidase-Deficiency.pdf</Literal>
</DataPropertyAssertion>

<DataPropertyAssertion>
    <DataProperty IRI="#hasDescription"/>
    <NamedIndividual IRI="#DBP_Manif_MotorDisability"/>
    <Literal>Discapacidad motora persistente, con afectación de la marcha y la coordinación motora fina y gruesa.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasSource"/>
    <NamedIndividual IRI="#DBP_Manif_MotorDisability"/>
    <Literal>Biotinidase-Deficiency.pdf</Literal>
</DataPropertyAssertion>

<DataPropertyAssertion>
    <DataProperty IRI="#hasDescription"/>
    <NamedIndividual IRI="#DBP_Manif_LanguageDisorder"/>
    <Literal>Trastorno persistente del lenguaje y la comunicación, asociado a hipoacusia y discapacidad intelectual.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasSource"/>
    <NamedIndividual IRI="#DBP_Manif_LanguageDisorder"/>
    <Literal>2007-Audiologic_findings_in_children_with_biotinidase_deficiency_in_Turkey.pdf</Literal>
</DataPropertyAssertion>

<DataPropertyAssertion>
    <DataProperty IRI="#hasDescription"/>
    <NamedIndividual IRI="#DBP_Manif_BrainAtrophy"/>
    <Literal>Atrofia cerebral crónica, evidenciada por neuroimagen, asociada a retraso del desarrollo y discapacidad intelectual.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasSource"/>
    <NamedIndividual IRI="#DBP_Manif_BrainAtrophy"/>
    <Literal>Biotinidase-Deficiency.pdf</Literal>
</DataPropertyAssertion>

<DataPropertyAssertion>
    <DataProperty IRI="#hasDescription"/>
    <NamedIndividual IRI="#DBP_Manif_WhiteMatterAbnormalities"/>
    <Literal>Alteraciones crónicas de la sustancia blanca cerebral, incluyendo desmielinización y leucoencefalopatía.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasSource"/>
    <NamedIndividual IRI="#DBP_Manif_WhiteMatterAbnormalities"/>
    <Literal>Biotinidase-Deficiency.pdf</Literal>
</DataPropertyAssertion>

