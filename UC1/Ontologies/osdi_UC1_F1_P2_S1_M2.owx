<!-- DESCRIPCIÓN Y FUENTES DE CADA MANIFESTACIÓN AGUDA -->
<DataPropertyAssertion>
    <DataProperty IRI="#hasDescription"/>
    <NamedIndividual IRI="#DBP_Manif_Seizures"/>
    <Literal>Convulsiones de inicio temprano, a menudo mioclónicas y refractarias a tratamiento convencional; pueden remitir con biotina.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasSource"/>
    <NamedIndividual IRI="#DBP_Manif_Seizures"/>
    <Literal>2011-Clinical_and_genetic_findings_in_patients_with_biotinidase_deficiency_detected_through_newb.pdf</Literal>
</DataPropertyAssertion>

<DataPropertyAssertion>
    <DataProperty IRI="#hasDescription"/>
    <NamedIndividual IRI="#DBP_Manif_Hypotonia"/>
    <Literal>Hipotonía muscular generalizada, frecuente en lactantes afectados.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasSource"/>
    <NamedIndividual IRI="#DBP_Manif_Hypotonia"/>
    <Literal>1999-Biotinidase_deficiency_a_treatable_genetic_disorder_in_the_Saudi_population.pdf</Literal>
</DataPropertyAssertion>

<DataPropertyAssertion>
    <DataProperty IRI="#hasDescription"/>
    <NamedIndividual IRI="#DBP_Manif_Ataxia"/>
    <Literal>Ataxia y alteraciones de la coordinación motora, descritas en episodios agudos.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasSource"/>
    <NamedIndividual IRI="#DBP_Manif_Ataxia"/>
    <Literal>2011-Clinical_and_genetic_findings_in_patients_with_biotinidase_deficiency_detected_through_newb.pdf</Literal>
</DataPropertyAssertion>

<DataPropertyAssertion>
    <DataProperty IRI="#hasDescription"/>
    <NamedIndividual IRI="#DBP_Manif_SkinRash"/>
    <Literal>Erupción cutánea aguda, eccema o dermatitis seborreica, a menudo perioral y exudativa.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasSource"/>
    <NamedIndividual IRI="#DBP_Manif_SkinRash"/>
    <Literal>Biotinidase-Deficiency.pdf</Literal>
</DataPropertyAssertion>

<DataPropertyAssertion>
    <DataProperty IRI="#hasDescription"/>
    <NamedIndividual IRI="#DBP_Manif_Alopecia"/>
    <Literal>Alopecia parcial o total, de aparición rápida, en ocasiones reversible con tratamiento.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasSource"/>
    <NamedIndividual IRI="#DBP_Manif_Alopecia"/>
    <Literal>1999-Biotinidase_deficiency_a_treatable_genetic_disorder_in_the_Saudi_population.pdf</Literal>
</DataPropertyAssertion>

<DataPropertyAssertion>
    <DataProperty IRI="#hasDescription"/>
    <NamedIndividual IRI="#DBP_Manif_MetabolicAcidosis"/>
    <Literal>Acidosis metabólica aguda, con elevación de lactato y otros ácidos orgánicos en sangre y orina.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasSource"/>
    <NamedIndividual IRI="#DBP_Manif_MetabolicAcidosis"/>
    <Literal>2011-Clinical_and_genetic_findings_in_patients_with_biotinidase_deficiency_detected_through_newb.pdf</Literal>
</DataPropertyAssertion>

<DataPropertyAssertion>
    <DataProperty IRI="#hasDescription"/>
    <NamedIndividual IRI="#DBP_Manif_Encephalopathy"/>
    <Literal>Encefalopatía aguda, con alteración del nivel de conciencia y regresión neurológica.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasSource"/>
    <NamedIndividual IRI="#DBP_Manif_Encephalopathy"/>
    <Literal>Biotinidase-Deficiency.pdf</Literal>
</DataPropertyAssertion>

<DataPropertyAssertion>
    <DataProperty IRI="#hasDescription"/>
    <NamedIndividual IRI="#DBP_Manif_Coma"/>
    <Literal>Coma secundario a descompensación metabólica grave.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasSource"/>
    <NamedIndividual IRI="#DBP_Manif_Coma"/>
    <Literal>1999-Biotinidase_deficiency_a_treatable_genetic_disorder_in_the_Saudi_population.pdf</Literal>
</DataPropertyAssertion>

<DataPropertyAssertion>
    <DataProperty IRI="#hasDescription"/>
    <NamedIndividual IRI="#DBP_Manif_Vomiting"/>
    <Literal>Vómitos recurrentes, asociados a episodios agudos de descompensación metabólica.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasSource"/>
    <NamedIndividual IRI="#DBP_Manif_Vomiting"/>
    <Literal>2011-Clinical_and_genetic_findings_in_patients_with_biotinidase_deficiency_detected_through_newb.pdf</Literal>
</DataPropertyAssertion>

<DataPropertyAssertion>
    <DataProperty IRI="#hasDescription"/>
    <NamedIndividual IRI="#DBP_Manif_BreathingProblems"/>
    <Literal>Problemas respiratorios agudos, incluyendo hiperventilación y distrés respiratorio.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasSource"/>
    <NamedIndividual IRI="#DBP_Manif_BreathingProblems"/>
    <Literal>2004-Outcome_in_patients_with_profound_biotinidase_deficiency_relevance_of_newborn_screening.pdf</Literal>
</DataPropertyAssertion>

<DataPropertyAssertion>
    <DataProperty IRI="#hasDescription"/>
    <NamedIndividual IRI="#DBP_Manif_Conjunctivitis"/>
    <Literal>Conjuntivitis aguda, a menudo asociada a otras manifestaciones cutáneas.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasSource"/>
    <NamedIndividual IRI="#DBP_Manif_Conjunctivitis"/>
    <Literal>1993-Ophthalmologic_Findings_in_Biotinidase_Deficiency.pdf</Literal>
</DataPropertyAssertion>


