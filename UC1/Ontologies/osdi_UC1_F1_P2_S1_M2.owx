</DataPropertyAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasSource"/>
    <NamedIndividual IRI="#DBP_Manif_Coma"/>
    <Literal>2003-Molecular_characterisation_and_neuropsychological_outcome_of_21_patients_with_profound_biot.pdf</Literal>
</DataPropertyAssertion>

<DataPropertyAssertion>
    <DataProperty IRI="#hasDescription"/>
    <NamedIndividual IRI="#DBP_Manif_Death"/>
    <Literal>Muerte secundaria a complicaciones neurológicas y metabólicas si no se instaura tratamiento.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasSource"/>
    <NamedIndividual IRI="#DBP_Manif_Death"/>
    <Literal>2011-Clinical_and_genetic_findings_in_patients_with_biotinidase_deficiency_detected_through_newb.pdf</Literal>
</DataPropertyAssertion>

<DataPropertyAssertion>
    <DataProperty IRI="#hasDescription"/>
    <NamedIndividual IRI="#DBP_Stage_Asymptomatic"/>
    <Literal>Fase presintomática, habitual en recién nacidos antes de la aparición de síntomas clínicos.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasDescription"/>
    <NamedIndividual IRI="#DBP_Stage_Symptomatic"/>
    <Literal>Fase sintomática, caracterizada por la aparición de manifestaciones neurológicas, cutáneas y metabólicas agudas.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasDescription"/>
    <NamedIndividual IRI="#DBP_Stage_IrreversibleDamage"/>
    <Literal>Fase de daño irreversible, con secuelas neurosensoriales (sordera, ceguera, discapacidad intelectual) permanentes.</Literal>
</DataPropertyAssertion>

