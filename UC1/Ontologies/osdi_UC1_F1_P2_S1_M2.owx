<DataPropertyAssertion>
    <DataProperty IRI="#hasDescription"/>
    <NamedIndividual IRI="#DBP_Followup_Profound"/>
    <Literal>Seguimiento clínico periódico en pacientes con deficiencia profunda: controles trimestrales el primer año y cada 6-12 meses después, incluyendo evaluación neurológica, auditiva, visual, desarrollo psicomotor y adherencia al tratamiento con biotina.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasSource"/>
    <NamedIndividual IRI="#DBP_Followup_Profound"/>
    <Literal>2011-Clinical_and_genetic_findings_in_patients_with_biotinidase_deficiency_detected_through_newb.pdf</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasSource"/>
    <NamedIndividual IRI="#DBP_Followup_Profound"/>
    <Literal>2004-Outcome_in_patients_with_profound_biotinidase_deficiency_relevance_of_newborn_screening.pdf</Literal>
</DataPropertyAssertion>

<DataPropertyAssertion>
    <DataProperty IRI="#hasDescription"/>
    <NamedIndividual IRI="#DBP_Followup_Partial"/>
    <Literal>Seguimiento clínico anual en pacientes con deficiencia parcial, centrado en la detección precoz de síntomas neurológicos o cutáneos, evaluación del desarrollo y refuerzo de la educación familiar sobre signos de alerta y uso de biotina en situaciones de estrés metabólico.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasSource"/>
    <NamedIndividual IRI="#DBP_Followup_Partial"/>
    <Literal>2011-Clinical_and_genetic_findings_in_patients_with_biotinidase_deficiency_detected_through_newb.pdf</Literal>
</DataPropertyAssertion>

<DataPropertyAssertion>
    <DataProperty IRI="#hasDescription"/>
    <NamedIndividual IRI="#DBP_Followup_Hearing"/>
    <Literal>Evaluación audiológica inicial (potenciales evocados auditivos, audiometría) y seguimiento anual en deficiencia profunda, especialmente si hubo retraso diagnóstico o síntomas iniciales. Adaptación de audífonos e indicación de implante coclear según necesidad.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasSource"/>
    <NamedIndividual IRI="#DBP_Followup_Hearing"/>
    <Literal>2007-Audiologic_findings_in_children_with_biotinidase_deficiency_in_Turkey.pdf</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
