<!-- DESCRIPCIÓN Y FUENTES DE CADA MANIFESTACIÓN Y ESTADIO -->
<DataPropertyAssertion>
    <DataProperty IRI="#hasDescription"/>
    <NamedIndividual IRI="#DBP_Manif_Seizures"/>
    <Literal>Convulsiones de inicio temprano, a menudo refractarias, que pueden remitir con tratamiento precoz con biotina.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasSource"/>
    <NamedIndividual IRI="#DBP_Manif_Seizures"/>
    <Literal>2011-Clinical_and_genetic_findings_in_patients_with_biotinidase_deficiency_detected_through_newb.pdf</Literal>
</DataPropertyAssertion>

<DataPropertyAssertion>
    <DataProperty IRI="#hasDescription"/>
    <NamedIndividual IRI="#DBP_Manif_Hypotonia"/>
    <Literal>Hipotonía muscular generalizada, presente en lactantes afectados.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasSource"/>
    <NamedIndividual IRI="#DBP_Manif_Hypotonia"/>
    <Literal>2003-Molecular_characterisation_and_neuropsychological_outcome_of_21_patients_with_profound_biot.pdf</Literal>
</DataPropertyAssertion>

<DataPropertyAssertion>
    <DataProperty IRI="#hasDescription"/>
    <NamedIndividual IRI="#DBP_Manif_Ataxia"/>
    <Literal>Ataxia y alteraciones de la coordinación motora.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasSource"/>
    <NamedIndividual IRI="#DBP_Manif_Ataxia"/>
    <Literal>2011-Clinical_and_genetic_findings_in_patients_with_biotinidase_deficiency_detected_through_newb.pdf</Literal>
</DataPropertyAssertion>

<DataPropertyAssertion>
    <DataProperty IRI="#hasDescription"/>
    <NamedIndividual IRI="#DBP_Manif_DevelopmentalDelay"/>
    <Literal>Retraso global del desarrollo psicomotor y cognitivo, a menudo irreversible si el tratamiento es tardío.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasSource"/>
    <NamedIndividual IRI="#DBP_Manif_DevelopmentalDelay"/>
    <Literal>2003-Molecular_characterisation_and_neuropsychological_outcome_of_21_patients_with_profound_biot.pdf</Literal>
</DataPropertyAssertion>

<DataPropertyAssertion>
    <DataProperty IRI="#hasDescription"/>
    <NamedIndividual IRI="#DBP_Manif_SensorineuralHearingLoss"/>
    <Literal>Pérdida auditiva neurosensorial, irreversible en la mayoría de los casos sintomáticos no tratados precozmente.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasSource"/>
    <NamedIndividual IRI="#DBP_Manif_SensorineuralHearingLoss"/>
    <Literal>2002-Hearing_loss_is_a_common_feature_of_symptomatic_children_with_profound_biotinidase_deficien.pdf</Literal>
</DataPropertyAssertion>

<DataPropertyAssertion>
    <DataProperty IRI="#hasDescription"/>
    <NamedIndividual IRI="#DBP_Manif_OpticAtrophy"/>
    <Literal>Atrofia óptica, con pérdida visual permanente en casos avanzados.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasSource"/>
    <NamedIndividual IRI="#DBP_Manif_OpticAtrophy"/>
    <Literal>2011-Clinical_and_genetic_findings_in_patients_with_biotinidase_deficiency_detected_through_newb.pdf</Literal>
</DataPropertyAssertion>

<DataPropertyAssertion>
    <DataProperty IRI="#hasDescription"/>
    <NamedIndividual IRI="#DBP_Manif_SkinRash"/>
    <Literal>Erupción cutánea, dermatitis seborreica o atópica, lesiones periorales exudativas.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasSource"/>
    <NamedIndividual IRI="#DBP_Manif_SkinRash"/>
    <Literal>2011-Clinical_and_genetic_findings_in_patients_with_biotinidase_deficiency_detected_through_newb.pdf</Literal>
</DataPropertyAssertion>

<DataPropertyAssertion>
    <DataProperty IRI="#hasDescription"/>
    <NamedIndividual IRI="#DBP_Manif_Alopecia"/>
    <Literal>Alopecia parcial o total, a menudo asociada a dermatitis.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasSource"/>
    <NamedIndividual IRI="#DBP_Manif_Alopecia"/>
    <Literal>2011-Clinical_and_genetic_findings_in_patients_with_biotinidase_deficiency_detected_through_newb.pdf</Literal>
</DataPropertyAssertion>

<DataPropertyAssertion>
    <DataProperty IRI="#hasDescription"/>
    <NamedIndividual IRI="#DBP_Manif_MetabolicAcidosis"/>
    <Literal>Acidosis metabólica, con elevación de lactato y otros ácidos orgánicos en sangre y orina.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasSource"/>
