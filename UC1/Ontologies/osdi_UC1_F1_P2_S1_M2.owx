    <NamedIndividual IRI="#DBP_Followup_Hearing"/>
    <Literal>2002-Hearing_loss_is_a_common_feature_of_symptomatic_children_with_profound_biotinidase_deficien.pdf</Literal>
</DataPropertyAssertion>

<DataPropertyAssertion>
    <DataProperty IRI="#hasDescription"/>
    <NamedIndividual IRI="#DBP_Followup_Visual"/>
    <Literal>Evaluación oftalmológica anual (fondo de ojo, potenciales evocados visuales) en deficiencia profunda, especialmente si hubo síntomas o retraso diagnóstico, para detectar atrofia óptica y deterioro visual.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasSource"/>
    <NamedIndividual IRI="#DBP_Followup_Visual"/>
    <Literal>Biotinidase-Deficiency.pdf</Literal>
</DataPropertyAssertion>

<DataPropertyAssertion>
    <DataProperty IRI="#hasDescription"/>
    <NamedIndividual IRI="#DBP_Followup_Neurodevelopment"/>
    <Literal>Evaluación del desarrollo psicomotor y cognitivo mediante escalas estandarizadas (Vineland, Griffith, Denver) al menos anual en deficiencia profunda, e intervención temprana si hay retrasos.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
