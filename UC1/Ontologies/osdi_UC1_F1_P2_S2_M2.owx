  <NamedIndividual IRI="#DPB_FollowUp_Parcial"/>
  <Literal>Revisión clínica periódica (anual o según criterio clínico), valoración del desarrollo, síntomas neurológicos y auditivos, y evaluación de la necesidad de tratamiento con biotina en situaciones de estrés metabólico. El seguimiento puede ser menos frecuente y, en ausencia de síntomas, puede limitarse a controles clínicos y educativos a lo largo de la infancia.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
  <DataProperty IRI="#hasFrequency"/>
  <NamedIndividual IRI="#DPB_FollowUp_Parcial"/>
  <Literal>Anual o según criterio clínico</Literal>
