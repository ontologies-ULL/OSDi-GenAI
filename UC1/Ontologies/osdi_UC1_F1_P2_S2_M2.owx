  <ObjectProperty IRI="#hasDataItemType"/>
  <NamedIndividual IRI="#DPBPartial_Prob_Seizures"/>
  <NamedIndividual IRI="#IRIDIProbability"/>
</ObjectPropertyAssertion>
<DataPropertyAssertion>
  <DataProperty IRI="#hasExpectedValue"/>
  <NamedIndividual IRI="#DPBPartial_Prob_Seizures"/>
  <Literal>0.02</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
  <DataProperty IRI="#hasDescription"/>
  <NamedIndividual IRI="#DPBPartial_Prob_Seizures"/>
  <Literal>Probabilidad de aparición de crisis convulsivas en la deficiencia parcial de biotinidasa sin tratamiento. Muy rara, generalmente asociada a factores estresantes.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
  <DataProperty IRI="#hasSource"/>
  <NamedIndividual IRI="#DPBPartial_Prob_Seizures"/>
  <Literal>Wolf B. Int J Neonatal Screen. 2022;8(2):28. PMID: 35631385; PMID: 2295967[3][6]</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
  <DataProperty IRI="#isTrueEpidemiologicalParameterEstimate"/>
  <NamedIndividual IRI="#DPBPartial_Prob_Seizures"/>
  <Literal>true</Literal>
</DataPropertyAssertion>

