<!-- Estrategia de seguimiento para deficiencia profunda de biotinidasa -->
<Declaration>
  <NamedIndividual IRI="#DPB_FollowUp_Profunda"/>
</Declaration>
<ClassAssertion>
  <Class IRI="#IRIFollowUpStrategy"/>
  <NamedIndividual IRI="#DPB_FollowUp_Profunda"/>
</ClassAssertion>
<DataPropertyAssertion>
  <DataProperty IRI="#hasName"/>
  <NamedIndividual IRI="#DPB_FollowUp_Profunda"/>
  <Literal>Seguimiento en deficiencia profunda de biotinidasa</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
  <DataProperty IRI="#hasDescription"/>
  <NamedIndividual IRI="#DPB_FollowUp_Profunda"/>
  <Literal>Revisión clínica pediátrica y metabólica periódica (cada 3-6 meses en los primeros años, luego anual), monitorización del desarrollo neurológico y auditivo, evaluación de adherencia al tratamiento con biotina, y realización de pruebas de laboratorio según indicación clínica. Se recomienda seguimiento de por vida.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
  <DataProperty IRI="#hasFrequency"/>
  <NamedIndividual IRI="#DPB_FollowUp_Profunda"/>
  <Literal>2-4 veces/año en infancia, anual en edad escolar y adulta</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
  <DataProperty IRI="#hasSource"/>
  <NamedIndividual IRI="#DPB_FollowUp_Profunda"/>
  <Literal>Wolf B. Int J Neonatal Screen. 2022;8(2):28. doi:10.3390/ijns8020028; NBS Verona, PMC8200396[2]</Literal>
</DataPropertyAssertion>

