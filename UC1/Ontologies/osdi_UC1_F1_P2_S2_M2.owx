<DataPropertyAssertion>
  <DataProperty IRI="#hasDescription"/>
  <NamedIndividual IRI="#DPB_Disease"/>
  <Literal>Deficiencia profunda de biotinidasa: trastorno metabólico hereditario que puede causar síntomas neurológicos y cutáneos graves si no se trata.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
  <DataProperty IRI="#hasRefToOMIM"/>
  <NamedIndividual IRI="#DPB_Disease"/>
  <Literal>253260</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
  <DataProperty IRI="#hasRefToSNOMED"/>
  <NamedIndividual IRI="#DPB_Disease"/>
  <Literal>190995004</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
  <DataProperty IRI="#hasRefToORDO"/>
  <NamedIndividual IRI="#DPB_Disease"/>
  <Literal>Orphanet:377</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
  <DataProperty IRI="#hasDescription"/>
  <NamedIndividual IRI="#DPB_Stage_Asymptomatic"/>
  <Literal>Estadio asintomático: el paciente no presenta síntomas clínicos.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
  <DataProperty IRI="#hasDescription"/>
  <NamedIndividual IRI="#DPB_Stage_Symptomatic"/>
  <Literal>Estadio sintomático: aparición de síntomas neurológicos y cutáneos agudos.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
  <DataProperty IRI="#hasDescription"/>
  <NamedIndividual IRI="#DPB_Stage_Sequelae"/>
  <Literal>Estadio de secuelas: déficit neurológicos persistentes, discapacidad intelectual, pérdida auditiva o visual.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
  <DataProperty IRI="#hasDescription"/>
  <NamedIndividual IRI="#DPB_Manif_Seizures"/>
  <Literal>Crisis epilépticas recurrentes.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
  <DataProperty IRI="#hasDescription"/>
  <NamedIndividual IRI="#DPB_Manif_Hypotonia"/>
  <Literal>Hipotonía muscular generalizada.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
  <DataProperty IRI="#hasDescription"/>
  <NamedIndividual IRI="#DPB_Manif_HearingLoss"/>
  <Literal>Pérdida auditiva neurosensorial irreversible.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
  <DataProperty IRI="#hasDescription"/>
  <NamedIndividual IRI="#DPB_Manif_VisualImpairment"/>
  <Literal>Alteraciones visuales, incluyendo atrofia óptica.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
  <DataProperty IRI="#hasDescription"/>
  <NamedIndividual IRI="#DPB_Manif_SkinRash"/>
  <Literal>Dermatitis eccematosa o eritematosa.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
  <DataProperty IRI="#hasDescription"/>
  <NamedIndividual IRI="#DPB_Manif_Alopecia"/>
  <Literal>Alopecia difusa.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
  <DataProperty IRI="#hasDescription"/>
  <NamedIndividual IRI="#DPB_Manif_DevelopmentalDelay"/>
  <Literal>Retraso global del desarrollo psicomotor.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
  <DataProperty IRI="#hasDescription"/>
  <NamedIndividual IRI="#DPB_Manif_MetabolicAcidosis"/>
  <Literal>Acidosis metabólica grave.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
  <DataProperty IRI="#hasDescription"/>
  <NamedIndividual IRI="#DPB_Manif_Ataxia"/>
  <Literal>Ataxia persistente.</Literal>
</DataPropertyAssertion>

<!-- Parámetro epidemiológico: Prevalencia al nacimiento de DPB profunda -->
<Declaration>
  <NamedIndividual IRI="#DPB_BirthPrevalence"/>
</Declaration>
<ClassAssertion>
  <Class IRI="#EpidemiologicalParameter"/>
  <NamedIndividual IRI="#DPB_BirthPrevalence"/>
</ClassAssertion>
<ClassAssertion>
  <Class IRI="#DeterministicParameter"/>
  <NamedIndividual IRI="#DPB_BirthPrevalence"/>
</ClassAssertion>
<ObjectPropertyAssertion>
  <ObjectProperty IRI="#isParameterOfDisease"/>
  <NamedIndividual IRI="#DPB_BirthPrevalence"/>
  <NamedIndividual IRI="#DPB_Disease"/>
</ObjectPropertyAssertion>
<ObjectPropertyAssertion>
  <ObjectProperty IRI="#hasDataItemType"/>
  <NamedIndividual IRI="#DPB_BirthPrevalence"/>
  <NamedIndividual IRI="#IRIDIBirthPrevalence"/>
</ObjectPropertyAssertion>
<DataPropertyAssertion>
  <DataProperty IRI="#hasExpectedValue"/>
  <NamedIndividual IRI="#DPB_BirthPrevalence"/>
  <Literal>0.0000167</Literal> <!-- 1/60,000 -->
</DataPropertyAssertion>
<DataPropertyAssertion>
  <DataProperty IRI="#hasDescription"/>
  <NamedIndividual IRI="#DPB_BirthPrevalence"/>
  <Literal>Prevalencia al nacimiento de la deficiencia profunda de biotinidasa en España.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
  <DataProperty IRI="#hasGeographicalContext"/>
  <NamedIndividual IRI="#DPB_BirthPrevalence"/>
  <Literal>España</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
  <DataProperty IRI="#hasYear"/>
  <NamedIndividual IRI="#DPB_BirthPrevalence"/>
  <Literal>2024</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
  <DataProperty IRI="#hasSource"/>
  <NamedIndividual IRI="#DPB_BirthPrevalence"/>
  <Literal>Wolf B. "Biotinidase Deficiency: Newborn Screening and Outcomes." Int J Neonatal Screen. 2022;8(2):28. doi:10.3390/ijns8020028</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
  <DataProperty IRI="#isTrueEpidemiologicalParameterEstimate"/>
  <NamedIndividual IRI="#DPB_BirthPrevalence"/>
  <Literal>true</Literal>
</DataPropertyAssertion>

