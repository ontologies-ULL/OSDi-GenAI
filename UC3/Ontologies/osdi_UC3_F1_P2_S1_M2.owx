<!-- 1. Entidad principal de la enfermedad -->
<Declaration>
    <NamedIndividual IRI="#BiotinidaseDeficiency"/>
</Declaration>
<ClassAssertion>
    <Class IRI="#RareDisease"/>
    <NamedIndividual IRI="#BiotinidaseDeficiency"/>
</ClassAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasDescription"/>
    <NamedIndividual IRI="#BiotinidaseDeficiency"/>
    <Literal>Deficiencia de biotinidasa (DB), error congénito del metabolismo con herencia autosómica recesiva, que afecta el reciclaje de la biotina.</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
    <DataProperty IRI="#hasSource"/>
    <NamedIndividual IRI="#BiotinidaseDeficiency"/>
    <Literal>GARD, ORDO, OMIM</Literal>
</DataPropertyAssertion>

