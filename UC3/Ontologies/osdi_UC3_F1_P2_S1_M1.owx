        <DataProperty IRI="#hasInitialProportion"/>
        <NamedIndividual IRI="#IRIBTDStageTotal"/>
        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#decimal">0.000014789</Literal>
    </DataPropertyAssertion>

    <!-- Parámetros Epidemiológicos -->
    <Declaration>
        <NamedIndividual IRI="#IRIBTDTotalPrevalenceAtBirth"/>
    </Declaration>
    <ClassAssertion>
        <Class IRI="#EpidemiologicalParameter"/>
        <NamedIndividual IRI="#IRIBTDTotalPrevalenceAtBirth"/>
    </ClassAssertion>
    <ClassAssertion>
        <Class IRI="#DeterministicParameter"/>
        <NamedIndividual IRI="#IRIBTDTotalPrevalenceAtBirth"/>
    </ClassAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasValue"/>
        <NamedIndividual IRI="#IRIBTDTotalPrevalenceAtBirth"/>
        <Literal>1/67620</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasExpectedValue"/>
        <NamedIndividual IRI="#IRIBTDTotalPrevalenceAtBirth"/>
        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#decimal">0.000014789</Literal>
    </DataPropertyAssertion>

