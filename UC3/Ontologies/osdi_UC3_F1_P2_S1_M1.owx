      <!-- Declaración de clases principales -->
    <Declaration>
        <Class IRI="#Disease"/>
    </Declaration>
    <Declaration>
        <Class IRI="#Stage"/>
    </Declaration>
    <Declaration>
        <Class IRI="#AcuteManifestation"/>
    </Declaration>
    <Declaration>
        <Class IRI="#ChronicManifestation"/>
    </Declaration>
    <Declaration>
        <Class IRI="#UtilityParameter"/>
    </Declaration>
    <Declaration>
        <Class IRI="#EpidemiologicalParameter"/>
    </Declaration>

    <!-- Enfermedad Principal -->
    <Declaration>
        <NamedIndividual IRI="#IRIBTDDisease"/>
    </Declaration>
    <ClassAssertion>
        <Class IRI="#Disease"/>
        <NamedIndividual IRI="#IRIBTDDisease"/>
    </ClassAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasName"/>
        <NamedIndividual IRI="#IRIBTDDisease"/>
        <Literal>Deficiencia de Biotinidasa</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasDescription"/>
        <NamedIndividual IRI="#IRIBTDDisease"/>
        <Literal>Error congénito del metabolismo del reciclaje de la biotina de herencia autosómica recesiva</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasOMIM"/>
        <NamedIndividual IRI="#IRIBTDDisease"/>
        <Literal>253260</Literal>
    </DataPropertyAssertion>

    <!-- Estadios de la Enfermedad -->
    <Declaration>
        <NamedIndividual IRI="#IRIBTDStageTotal"/>
    </Declaration>
    <ClassAssertion>
        <Class IRI="#Stage"/>
        <NamedIndividual IRI="#IRIBTDStageTotal"/>
    </ClassAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasName"/>
        <NamedIndividual IRI="#IRIBTDStageTotal"/>
        <Literal>Deficiencia Total de Biotinidasa</Literal>
    </DataPropertyAssertion>
