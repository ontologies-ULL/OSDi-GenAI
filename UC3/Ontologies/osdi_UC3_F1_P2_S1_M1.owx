        <NamedIndividual IRI="#IRIBTDManifConvulsionsU"/>
    </Declaration>
    <ClassAssertion>
        <Class IRI="#UtilityParameter"/>
        <NamedIndividual IRI="#IRIBTDManifConvulsionsU"/>
