        <DataProperty IRI="#hasSpecificity"/>
        <NamedIndividual IRI="#IRIBTDInterventionScreening"/>
        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#decimal">0.9995</Literal>
    </DataPropertyAssertion>

    <!-- Tratamientos -->
