        <!-- Prevalencia Total -->
    <Declaration>
        <NamedIndividual IRI="#IRIBTDTotalPrevalenceAtBirth"/>
    </Declaration>
    <ClassAssertion>
        <Class IRI="#EpidemiologicalParameter"/>
        <NamedIndividual IRI="#IRIBTDTotalPrevalenceAtBirth"/>
    </ClassAssertion>
    <ClassAssertion>
        <Class IRI="#DeterministicParameter"/>
        <NamedIndividual IRI="#IRIBTDTotalPrevalenceAtBirth"/>
    </ClassAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasName"/>
        <NamedIndividual IRI="#IRIBTDTotalPrevalenceAtBirth"/>
        <Literal>Prevalencia al nacimiento de deficiencia total de biotinidasa</Literal>
    </DataPropertyAssertion>
