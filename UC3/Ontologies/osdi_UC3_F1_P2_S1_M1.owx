    <DataPropertyAssertion>
        <DataProperty IRI="#hasConfidenceInterval"/>
        <NamedIndividual IRI="#IRIBTDManifConvulsionsU"/>
        <Literal>[0.795-0.885]</Literal>
    </DataPropertyAssertion>

    <!-- Intervenciones -->
    <Declaration>
        <NamedIndividual IRI="#IRIBTDInterventionScreening"/>
    </Declaration>
    <ClassAssertion>
        <Class IRI="#ScreeningIntervention"/>
        <NamedIndividual IRI="#IRIBTDInterventionScreening"/>
