<!-- Probabilidad anual de hipoacusia neurosensorial en PBD no tratada -->
<Declaration>
  <NamedIndividual IRI="#PBD_Manif_HearingProblems_RR"/>
</Declaration>
<ClassAssertion>
  <Class IRI="#Parameter"/>
  <NamedIndividual IRI="#PBD_Manif_HearingProblems_RR"/>
</ClassAssertion>
<ClassAssertion>
  <Class IRI="#EpidemiologicalParameter"/>
  <NamedIndividual IRI="#PBD_Manif_HearingProblems_RR"/>
</ClassAssertion>
<DataPropertyAssertion>
  <DataProperty IRI="#hasDescription"/>
  <NamedIndividual IRI="#PBD_Manif_HearingProblems_RR"/>
  <Literal>Probabilidad de desarrollar hipoacusia neurosensorial en niños con PBD no tratados durante el primer año de vida</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
  <DataProperty IRI="#hasExpectedValue"/>
  <NamedIndividual IRI="#PBD_Manif_HearingProblems_RR"/>
  <Literal>0.55</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
  <DataProperty IRI="#hasLower95CI"/>
  <NamedIndividual IRI="#PBD_Manif_HearingProblems_RR"/>
  <Literal>0.45</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
  <DataProperty IRI="#hasUpper95CI"/>
  <NamedIndividual IRI="#PBD_Manif_HearingProblems_RR"/>
  <Literal>0.65</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
  <DataProperty IRI="#hasSource"/>
  <NamedIndividual IRI="#PBD_Manif_HearingProblems_RR"/>
  <Literal>Genc GA et al., 2007, Audiologic findings in children with biotinidase deficiency in Turkey</Literal>
</DataPropertyAssertion>
<DataPropertyAssertion>
  <DataProperty IRI="#hasYear"/>
  <NamedIndividual IRI="#PBD_Manif_HearingProblems_RR"/>
  <Literal>2007</Literal>
</DataPropertyAssertion>

